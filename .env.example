# Local MySQL settings
DB_URL=jdbc:mysql://localhost:3306/campusfix?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=campusfix_user
DB_PASSWORD=replace_with_your_mysql_password

# Replace with a random secret of at least 32 characters
APP_JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: if set, create/promote this account as ADMIN at startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_12_chars_minimum
ADMIN_NAME=CampusFix Administrator

# Frontend build-time setting (set in frontend/.env for local use)
VITE_API_URL=http://localhost:8080
